		}
		reverse_proxy gtm-app:3000
	}
}

# --- athletedatahub ---
athletedatahub.com {
	encode gzip zstd
	reverse_proxy athletedatahub:3000 {
		trusted_proxies private_ranges
	}
}

athletedatahub.fr {
	encode gzip zstd
	reverse_proxy athletedatahub:3000 {
		trusted_proxies private_ranges
	}
}

demo.korvus.fr {
	encode gzip zstd
	reverse_proxy athletedatahub:3000 {
		trusted_proxies private_ranges
	}
}

www.athletedatahub.com {
	redir https://athletedatahub.com{uri} permanent
}

